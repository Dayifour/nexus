// Modèle de persistance Nexus AI (cahier maître §11).
// `Event` est la source de vérité, en ajout seul. Les autres modèles sont des projections matérialisées,
// écrites dans la même transaction que l'événement qui les modifie (NFR-002).
// Les charges JSON sont stockées en texte, déjà expurgées : aucun secret n'atteint la base (NFR-008).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  // Forge exécute le process principal dans un bundle CommonJS. Le client généré CJS
  // évite `import.meta.url`, indisponible dans ce bundle.
  moduleFormat           = "cjs"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Event {
  globalSequence       Int      @id @default(autoincrement())
  eventId              String   @unique
  aggregateType        String
  aggregateId          String
  aggregateVersion     Int
  eventType            String
  payloadSchemaVersion Int
  payloadJson          String
  occurredAt           String
  correlationId        String
  causationId          String?
  actorType            String
  actorId              String
  recordedAt           String

  @@unique([aggregateId, aggregateVersion])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("events")
}

model Project {
  id              String   @id
  name            String
  rootPath        String   @unique
  isGitRepository Boolean
  protectEnvFiles Boolean  @default(false)
  createdAt       String
  updatedAt       String
  version         Int
  teams           Team[]
  missions        Mission[]

  @@map("projects")
}

model Team {
  id             String         @id
  projectId      String
  name           String
  governanceMode String
  supervisorId   String?
  createdAt      String
  updatedAt      String
  version        Int
  project        Project        @relation(fields: [projectId], references: [id])
  members        AgentProfile[]

  @@unique([projectId, name])
  @@map("teams")
}

model AgentProfile {
  id                  String  @id
  teamId              String
  role                String
  displayName         String
  connectorId         String
  providerAccountId   String?
  permissionMode      String
  authMode            String  @default("vendor-login")
  capabilitiesJson    String
  createdAt           String
  updatedAt           String
  version             Int
  team                Team    @relation(fields: [teamId], references: [id])

  @@map("agent_profiles")
}

model Mission {
  id          String  @id
  projectId   String
  teamId      String
  title       String
  prompt      String
  status      String
  createdAt   String
  updatedAt   String
  version     Int
  project     Project @relation(fields: [projectId], references: [id])
  tasks       Task[]

  @@index([projectId])
  @@map("missions")
}

model Task {
  id                String  @id
  missionId         String
  title             String
  description       String
  status            String
  assignedAgentId   String?
  allowedPathsJson  String
  acceptanceJson    String
  attempt           Int     @default(0)
  maxAttempts       Int     @default(2)
  lastFailureCode   String?
  planKey           String?
  createdAt         String
  updatedAt         String
  version           Int
  mission           Mission @relation(fields: [missionId], references: [id])

  @@index([missionId, status])
  @@map("tasks")
}

model TaskDependency {
  taskId      String
  dependsOnId String

  @@id([taskId, dependsOnId])
  @@map("task_dependencies")
}

model Session {
  id              String  @id
  projectId       String
  agentProfileId  String
  title           String
  createdAt       String
  updatedAt       String

  @@index([projectId])
  @@map("sessions")
}

model AgentRun {
  id               String  @id
  taskId           String
  sessionId        String
  connectorId      String
  connectorVersion String?
  nativeSessionId  String?
  pid              Int?
  runnerInstanceId String?
  status           String
  startedAt        String
  endedAt          String?
  lastSequence     Int     @default(0)

  @@index([taskId])
  @@index([status])
  @@map("agent_runs")
}

model Approval {
  id              String  @id
  action          String
  projectId       String
  taskId          String?
  summary         String
  planFingerprint String
  status          String
  requestedAt     String
  expiresAt       String
  decidedAt       String?

  @@index([status])
  @@map("approvals")
}

model UsageSnapshot {
  id           String  @id
  connectorId  String
  accountId    String?
  observedAt   String
  source       String
  remaining    Float?
  consumed     Float?
  unit         String?
  windowEnd    String?
  caveat       String?

  @@index([connectorId, observedAt])
  @@map("usage_snapshots")
}

{
  "name": "@nexus/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Desktop local-first Nexus AI.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "echo \"lint centralisé à la racine (ppnpm run lint)\"",
    "lint:fix": "echo \"lint centralisé à la racine (ppnpm run lint)\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\" \"tests/**/*.test.mts\"",
    "e2e": "electron-forge package && xvfb-run -a node --test --test-concurrency=1 \"e2e/**/*.e2e.ts\"",
    "make:linux": "electron-forge make --platform linux"
  },
  "dependencies": {
    "@nexus/app-services": "workspace:*",
    "@nexus/contracts": "workspace:*",
    "@nexus/secrets": "workspace:*",
    "@radix-ui/react-context-menu": "2.3.8",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "dockview": "8.5.1",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "1.55.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-winstaller": "5.4.4",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  },
  "productName": "Nexus AI",
  "license": "Apache-2.0",
  "author": "Dayifour (https://github.com/Dayifour)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dayifour/nexus.git"
  }
}
